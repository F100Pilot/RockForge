# Copy to .env and adjust as needed (.env is gitignored — per-machine config).

# REQUIRED for docker-compose (the one deployment path that opens a network
# port). Local single-user setups (start.bat / the standalone .exe, both bound
# to 127.0.0.1) don't need this — leave it unset there. Once set, the browser's
# native login prompt asks for it (any username, this as the password).
# ROCKFORGE_API_TOKEN=change-me-to-a-real-secret

# Device para o ML (separação Demucs, transcrição WhisperX):
#   auto  -> usa a GPU NVIDIA se houver uma utilizável, senão CPU (default)
#   cuda  -> força GPU (precisa do build CUDA do PyTorch — ver README §2b)
#   cpu   -> força CPU
# ROCKFORGE_DEMUCS_DEVICE=auto

# Sobrepõe o device só da deteção de letra (por defeito segue DEMUCS_DEVICE).
# ROCKFORGE_WHISPERX_DEVICE=cuda

# Modelo WhisperX da deteção de letra: tiny/base/small/medium/large-v3.
# Maior = mais preciso e mais lento; em CPU baixa para base/tiny.
# ROCKFORGE_WHISPER_MODEL=small
